{
  "name": "@kraken/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --env-file-if-exists=../.env --watch src/index.js",
    "migrate": "node --env-file-if-exists=../.env src/migrate.js",
    "seed": "node --env-file-if-exists=../.env src/seed.js",
    "test": "node --test test/*.test.js",
    "bootstrap": "node --env-file-if-exists=../.env src/bootstrap.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "zod": "^4.1.12",
    "helmet": "^8.1.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^8.2.1",
    "nodemailer": "^10.4.0",
    "pdfkit": "^0.17.2",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "supertest": "^7.1.4"
  }
}
